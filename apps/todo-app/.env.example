# Postgres connection string. Works with Neon, Supabase, or local Postgres.
# Neon example:     postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Local example:    postgresql://postgres:postgres@localhost:5432/todo_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_dev

# Set to "disable" for local Postgres without SSL. Leave unset for Neon/Supabase.
# PGSSL=disable

PORT=3000
